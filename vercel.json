{
  "version": 2,
  "name": "iot-livestock-frontend",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "(.*)", "dest": "/$1" }
  ]
}
